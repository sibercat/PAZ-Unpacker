// Version resource.
//
// This exists for more than cosmetics. An unsigned PE carrying no VERSIONINFO
// at all is a heavily weighted input to Defender's ML classifier, which is what
// produced the Trojan:Win32/Wacatac.B!ml false positive on the 2.4.0 release.
// Version numbers come from Version.h so they cannot drift from APP_VERSION.

#include <windows.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
 PRODUCTVERSION APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS      VS_FF_DEBUG
#else
 FILEFLAGS      0x0L
#endif
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "sibercat"
            VALUE "FileDescription",  "PAZ Unpacker - Black Desert Online archive extractor"
            VALUE "FileVersion",      APP_VERSION_A
            VALUE "InternalName",     "PAZ-Unpacker"
            VALUE "LegalCopyright",   "Copyright (C) 2026 sibercat. MIT License. Based on PAZ-Unpacker by kukdh1."
            VALUE "OriginalFilename", "PAZ-Unpacker.exe"
            VALUE "ProductName",      "PAZ Unpacker"
            VALUE "ProductVersion",   APP_VERSION_A
            VALUE "Comments",         "https://github.com/sibercat/PAZ-Unpacker"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
